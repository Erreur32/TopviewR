# Copy to .env and fill in. Never commit .env.
# btop (default), htop or nvtop (GPU, needs /dev/dri in the compose)
BTOP_TOOL=btop
BTOP_USER=admin
# 12 characters minimum. Generate one: openssl rand -base64 24
BTOP_PASS=
# off | auto (self-signed certificate generated in ./certs) | on (certificate provided in ./certs)
BTOP_TLS=auto
# Extra certificate names and IPs, comma-separated
BTOP_TLS_SAN=192.168.32.10,media.lan
BTOP_PORT=7681
# Listen IP (empty = all interfaces). E.g. the server LAN IP
BTOP_BIND=
# true: ttyd notices in the logs (each connection, startup config). Default: errors and warnings only
BTOP_DEBUG=false
BTOP_CONTAINER_NAME=TopviewR
BTOP_IMAGE=ghcr.io/erreur32/topviewr:latest
