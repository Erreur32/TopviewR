# Copy to .env and fill in. Never commit .env.
# Initial tool: btop (default), htop or nvtop (GPU: docker-compose.amd-intel.yaml or docker-compose.nvidia.yaml)
BTOP_TOOL=btop
# true: a new session starts on the last tool used (reconnect, page reload, new tab, container restart)
# false: always start on BTOP_TOOL
BTOP_RESTORE_LAST=true
# true: one HTTPS request to the GitHub releases API at container start, shown in the footer/menu
# false: no outbound request
BTOP_UPDATE_CHECK=true
BTOP_USER=admin
# 12 characters minimum. Generate one: openssl rand -base64 24
BTOP_PASS=
# off | auto (self-signed certificate generated in ./certs) | on (certificate provided in ./certs)
BTOP_TLS=auto
# Extra certificate names and IPs, comma-separated
BTOP_TLS_SAN=192.168.32.10,media.lan
BTOP_PORT=7681
# Listen IP (empty = all interfaces). E.g. the server LAN IP
BTOP_BIND=
# true: ttyd notices in the logs (each connection, startup config). Default: errors and warnings only
BTOP_DEBUG=false
BTOP_CONTAINER_NAME=TopviewR
# Image for docker-compose.yaml and docker-compose.amd-intel.yaml (docker-compose.nvidia.yaml sets its own)
BTOP_IMAGE=ghcr.io/erreur32/topviewr:latest
