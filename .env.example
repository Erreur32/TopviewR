# Copier en .env et remplir. Ne jamais versionner .env.
BTOP_USER=admin
# 12 caractères minimum. Générer : openssl rand -base64 24
BTOP_PASS=
# off | auto (certificat auto-signé généré dans ./certs) | on (certificat fourni dans ./certs)
BTOP_TLS=auto
# Noms et IP supplémentaires du certificat, séparés par des virgules
BTOP_TLS_SAN=192.168.1.10,media.lan
BTOP_PORT=7681
# IP d'écoute (vide = toutes les interfaces). Ex : l'IP LAN du serveur
BTOP_BIND=
BTOP_CONTAINER_NAME=BTOP_media
BTOP_IMAGE=ghcr.io/erreur32/btop-web:latest
